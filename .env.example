# Mabati environment configuration
# Copy to .env and fill in real values. Never commit .env.

# Flask session signing key — generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Admin dashboard password
ADMIN_PASSWORD=choose-a-strong-password

# Business contact details (shown on the public site)
BUSINESS_NAME=Mabati Ironsheets
BUSINESS_PHONE=+254700000000
BUSINESS_WHATSAPP=254700000000
BUSINESS_LOCATION=Nairobi, Kenya

# Port the Flask app listens on (behind gunicorn/nginx)
PORT=5000
